# 어드민 공용 로그인 비밀번호 (팀원 모두 동일한 값 사용)
ADMIN_PASSWORD=
# 세션 쿠키 서명용 시크릿 (openssl rand -hex 32 로 생성)
ADMIN_SESSION_SECRET=

# LetsOperation(멘토 DB 원본) 주소. 멘토 DB 페이지가 읽기 전용으로 가져오고, 수정 버튼은 이 주소의 /mentors/db 로 보낸다.
LETS_OPERATION_URL=https://letscareer-operation.vercel.app
# LetsOperation 의 EXTERNAL_API_TOKEN 과 같은 값. 서버에서만 쓰고 브라우저로 내보내지 않는다.
LETS_OPERATION_API_TOKEN=
